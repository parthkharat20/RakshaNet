# RakshaNet Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + PostGIS
POSTGRES_USER=rakshanet
POSTGRES_PASSWORD=rakshanet_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rakshanet_db
DATABASE_URL=postgresql+asyncpg://rakshanet:rakshanet_secret@localhost:5432/rakshanet_db
SYNC_DATABASE_URL=postgresql://rakshanet:rakshanet_secret@localhost:5432/rakshanet_db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rakshanet_secret

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security / Auth
JWT_SECRET_KEY=rakshanet_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
