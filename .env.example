# Project Settings
PROJECT_NAME=RakshaNet
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# PostgreSQL + PostGIS Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=raksha
POSTGRES_PASSWORD=rakshanet_secret
POSTGRES_DB=rakshanet
DATABASE_URL=postgresql+asyncpg://raksha:rakshanet_secret@localhost:5432/rakshanet

# Neo4j Graph Database Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=rakshanet_secret

# Redis In-Memory Cache & Pub/Sub Settings
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=rakshanet_super_secure_jwt_secret_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
